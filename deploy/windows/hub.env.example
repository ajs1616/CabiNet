# Copy this file to hub.env (same folder) and fill in this PC's LAN address -
# the one you RESERVED for it on your router (deploy/WINDOWS_HUB.md, step 1).
# It becomes the hub's --host-base: every glass URL and the address DHCP
# option 43 hands the machines. If it ever changes, every machine is orphaned.
HUB_IP=192.168.1.50

# Optional: a specific Python 3.11+ if `py -3` / `python` on PATH is the wrong
# one (an old 3.6 on PATH is a classic).
#CABINET_PYTHON=C:\Python313\python.exe
